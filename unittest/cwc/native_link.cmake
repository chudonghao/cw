# Exercise native driver inputs through commands, generated files and the real linker.
file(MAKE_DIRECTORY "${TEST_WORK_DIRECTORY}/tmp")
set(ENV{TMPDIR} "${TEST_WORK_DIRECTORY}/tmp")

function(make_archive name)
  execute_process(COMMAND "${ARCHIVER}" rcs "${name}" ${ARGN}
    WORKING_DIRECTORY "${TEST_WORK_DIRECTORY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "cannot create test archive ${name}:\n${output}\n${error}")
  endif()
endfunction()

function(assert_clean_temporary_files)
  file(GLOB remaining "${TEST_WORK_DIRECTORY}/tmp/cwc-*" "${TEST_WORK_DIRECTORY}/.cwc-*")
  if(remaining)
    message(FATAL_ERROR "${CASE_NAME}: temporary files remain: ${remaining}")
  endif()
endfunction()

function(expect_preserved_failure diagnostic)
  file(WRITE "${TEST_WORK_DIRECTORY}/protected" "old executable\n")
  execute_cwc(1 ${ARGN} -o protected)
  assert_contains("${CWC_ERROR}" "${diagnostic}" "${CASE_NAME} diagnostic")
  assert_file_contents("${TEST_WORK_DIRECTORY}/protected" "old executable\n")
  assert_absent("${TEST_WORK_DIRECTORY}/protected.cwi")
  assert_clean_temporary_files()
endfunction()

if(DRIVER_SCENARIO STREQUAL "native_input_modes")
  configure_file("${CASE_SOURCE}" "${TEST_WORK_DIRECTORY}/entry.cw" COPYONLY)
  execute_cwc(0 -c entry.cw -o entry.o)
  execute_cwc(0 entry.o)
  execute_program(0 "${TEST_WORK_DIRECTORY}/a.out")
  assert_absent("${TEST_WORK_DIRECTORY}/a.cwi")
  execute_cwc(0 entry.o -o "named program")
  execute_program(0 "${TEST_WORK_DIRECTORY}/named program")
  assert_absent("${TEST_WORK_DIRECTORY}/named program.cwi")
  # An interface-only frontend unit may use an entry from an existing object.
  execute_cwc(0 entry.cwi entry.o -o interface-only)
  execute_program(0 "${TEST_WORK_DIRECTORY}/interface-only")
  execute_cwc(1 -o rejected)
  assert_contains("${CWC_ERROR}" "no input files" "empty input diagnostic")
  execute_cwc(1 -L "${TEST_WORK_DIRECTORY}" -o rejected)
  assert_contains("${CWC_ERROR}" "no input files" "search path is not an input")
  execute_cwc(1 entry.o -o -)
  assert_contains("${CWC_ERROR}" "cannot be written to standard output" "executable stdout")
  execute_cwc(1 -c entry.o -o rejected.o)
  assert_contains("${CWC_ERROR}" "requires executable output" "object in compile mode")
  execute_cwc(1 -S -emit-llvm entry.o -o rejected.ll)
  assert_contains("${CWC_ERROR}" "requires executable output" "object in IR mode")
  execute_cwc(1 --target=wasm32-unknown-unknown entry.o -o rejected.wasm)
  assert_contains("${CWC_ERROR}" "accepts CW source files only" "Wasm input boundary")
  execute_cwc(1 entry.o -Wl,-dead_strip -o rejected)
  assert_contains("${CWC_ERROR}" "linker options are not supported for native output" "native option boundary")
  file(WRITE "${TEST_WORK_DIRECTORY}/helper.cw" "func Answer() i32 { 7 }\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/stdin.cw" "func main() i32 { Answer() }\n")
  execute_process(COMMAND "${CWC_EXECUTABLE}" helper.cw - -o from-stdin
    INPUT_FILE "${TEST_WORK_DIRECTORY}/stdin.cw" WORKING_DIRECTORY "${TEST_WORK_DIRECTORY}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "multi-input standard input failed: ${error}")
  endif()
  execute_program(7 "${TEST_WORK_DIRECTORY}/from-stdin")
  execute_cwc(1 - - -o rejected)
  assert_contains("${CWC_ERROR}" "standard input may only be specified once" "repeated standard input")

elseif(DRIVER_SCENARIO STREQUAL "native_library_inputs")
  file(WRITE "${TEST_WORK_DIRECTORY}/provider.cw" "export func Value() i32 { 42 }\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/consumer.cw" "func main() i32 { Value() }\n")
  execute_cwc(0 -c provider.cw -o provider.o)
  execute_cwc(0 -c provider.cwi consumer.cw -o consumer.o)
  make_archive(libprovider.a provider.o)
  execute_cwc(0 consumer.o libprovider.a -o archive)
  execute_program(42 "${TEST_WORK_DIRECTORY}/archive")
  execute_cwc(0 consumer.o -L "${TEST_WORK_DIRECTORY}" -lprovider -o library)
  execute_program(42 "${TEST_WORK_DIRECTORY}/library")
  execute_process(COMMAND "${CXX_COMPILER}" -dynamiclib provider.o
    -Xlinker -install_name -Xlinker "${TEST_WORK_DIRECTORY}/libprovider.dylib" -o libprovider.dylib
    WORKING_DIRECTORY "${TEST_WORK_DIRECTORY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "cannot create test dynamic library:\n${output}\n${error}")
  endif()
  execute_cwc(0 consumer.o libprovider.dylib -o dynamic)
  execute_program(42 "${TEST_WORK_DIRECTORY}/dynamic")
  execute_cwc(0 provider.cwi consumer.cw libprovider.dylib -o mixed)
  execute_program(42 "${TEST_WORK_DIRECTORY}/mixed")
  execute_cwc(0 -c "${CASE_SOURCE}" -o entry.o)
  make_archive(libentry.a entry.o)
  execute_cwc(0 libentry.a -o archive-entry)
  execute_program(0 "${TEST_WORK_DIRECTORY}/archive-entry")
  execute_cwc(0 -L "${TEST_WORK_DIRECTORY}" -lentry -o library-entry)
  execute_program(0 "${TEST_WORK_DIRECTORY}/library-entry")

elseif(DRIVER_SCENARIO STREQUAL "native_mixed_inputs")
  file(WRITE "${TEST_WORK_DIRECTORY}/pre.cw" "export func Pre() i32 { 1 }\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/tail.cw" "export func Tail() i32 { 2 }\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/provider.cw" "export func Value() i32 { 42 }\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/main.cw" "func main() i32 { Helper() }\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/helper.cw" [=[
import func Pre() i32;
import func Tail() i32;
func Helper() i32 { Pre() + Value() + Tail() }
]=])
  execute_cwc(0 -c pre.cw -o pre.o)
  execute_cwc(0 -c tail.cw -o tail.o)
  execute_cwc(0 -c provider.cw -o provider.o)
  make_archive(libsupport.a provider.o)
  execute_cwc(0 pre.o provider.cwi main.cw -L "${TEST_WORK_DIRECTORY}" -lsupport helper.cw tail.o -o interface-first)
  execute_program(45 "${TEST_WORK_DIRECTORY}/interface-first")
  assert_clean_temporary_files()
  execute_cwc(0 pre.o main.cw libsupport.a provider.cwi helper.cw tail.o -o source-first)
  execute_program(45 "${TEST_WORK_DIRECTORY}/source-first")
  assert_clean_temporary_files()
  execute_cwc(0 -c provider.cwi main.cw helper.cw -o combined.o)
  execute_cwc(0 tail.o combined.o -L "${TEST_WORK_DIRECTORY}" -lsupport pre.o -o pure)
  execute_program(45 "${TEST_WORK_DIRECTORY}/pure")

elseif(DRIVER_SCENARIO STREQUAL "native_initialization_order")
  file(WRITE "${TEST_WORK_DIRECTORY}/common.cw" [=[
var order i32 := 0;
func Mark(value i32) i32 { order = order * 10 + value; order }
func main() i32 { order }
]=])
  file(WRITE "${TEST_WORK_DIRECTORY}/first.cw" "var first i32 := Mark(1);\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/second.cw" "var second i32 := Mark(2);\n")
  execute_cwc(0 common.cw first.cw second.cw -o forward)
  execute_program(12 "${TEST_WORK_DIRECTORY}/forward")
  execute_cwc(0 common.cw second.cw first.cw -o reversed)
  execute_program(21 "${TEST_WORK_DIRECTORY}/reversed")
  execute_cwc(0 -c common.cw first.cw second.cw -o combined.o)
  execute_cwc(0 combined.o -o separate)
  execute_program(12 "${TEST_WORK_DIRECTORY}/separate")

elseif(DRIVER_SCENARIO STREQUAL "native_link_failures")
  configure_file("${CASE_SOURCE}" "${TEST_WORK_DIRECTORY}/entry.cw" COPYONLY)
  execute_cwc(0 -c entry.cw -o entry.o)
  file(WRITE "${TEST_WORK_DIRECTORY}/library.cw" "func Unused() {}\n")
  execute_cwc(0 -c library.cw -o library.o)
  file(WRITE "${TEST_WORK_DIRECTORY}/undefined.cw"
    "import func Missing() i32; func main() i32 { Missing() }\n")
  execute_cwc(0 -c undefined.cw -o undefined.o)
  file(WRITE "${TEST_WORK_DIRECTORY}/broken.cwi" "import func Broken( {\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/invalid.cw" "func Invalid() i32 { missing }\n")
  file(WRITE "${TEST_WORK_DIRECTORY}/invalid.o" "not an object\n")
  expect_preserved_failure("broken.cwi" broken.cwi entry.o)
  expect_preserved_failure("missing" invalid.cw entry.o)
  expect_preserved_failure("cannot read link input" missing.o)
  expect_preserved_failure("cannot read link input" entry.cw missing.o)
  expect_preserved_failure("invalid.o" invalid.o)
  expect_preserved_failure("cwc_missing_library" -L "${TEST_WORK_DIRECTORY}" -lcwc_missing_library)
  expect_preserved_failure("main" library.o)
  expect_preserved_failure("cw:Missing:func()i32" undefined.o)
  expect_preserved_failure("cw:Missing:func()i32" undefined.cw)
  expect_preserved_failure("duplicate symbol" entry.cw entry.o)
  execute_cwc(1 undefined.o -o absent)
  assert_absent("${TEST_WORK_DIRECTORY}/absent")

elseif(DRIVER_SCENARIO STREQUAL "native_output_protection")
  configure_file("${CASE_SOURCE}" "${TEST_WORK_DIRECTORY}/entry.cw" COPYONLY)
  execute_cwc(0 -c entry.cw -o entry.o)
  make_archive(libentry.a entry.o)
  foreach(input IN ITEMS entry.cw entry.cwi entry.o libentry.a)
    set(inputs "${input}")
    if(input MATCHES "\\.cw(i)?$")
      set(inputs entry.cwi entry.cw)
    endif()
    file(SHA256 "${TEST_WORK_DIRECTORY}/${input}" before)
    foreach(identity IN ITEMS same_file symbolic_link hard_link)
      set(output "${TEST_WORK_DIRECTORY}/${input}")
      if(NOT identity STREQUAL "same_file")
        set(output "${TEST_WORK_DIRECTORY}/${input}-${identity}")
        set(link_options "")
        if(identity STREQUAL "symbolic_link")
          set(link_options SYMBOLIC)
        endif()
        file(CREATE_LINK "${TEST_WORK_DIRECTORY}/${input}" "${output}" ${link_options} RESULT result)
        if(NOT "${result}" STREQUAL "0")
          message(FATAL_ERROR "cannot create ${identity}: ${result}")
        endif()
      endif()
      execute_cwc(1 ${inputs} -o "${output}")
      assert_contains("${CWC_ERROR}" "refers to input" "${input}/${identity} protection")
      file(SHA256 "${TEST_WORK_DIRECTORY}/${input}" after)
      if(NOT "${before}" STREQUAL "${after}")
        message(FATAL_ERROR "${input}/${identity}: input content changed")
      endif()
    endforeach()
  endforeach()

elseif(DRIVER_SCENARIO STREQUAL "native_temporary_files")
  configure_file("${CASE_SOURCE}" "${TEST_WORK_DIRECTORY}/entry.cw" COPYONLY)
  execute_cwc(0 -c entry.cw -o entry.o)
  execute_cwc(0 entry.cw -o source)
  execute_program(0 "${TEST_WORK_DIRECTORY}/source")
  assert_clean_temporary_files()
  execute_cwc(0 entry.o -o pure)
  execute_program(0 "${TEST_WORK_DIRECTORY}/pure")
  assert_clean_temporary_files()
  file(WRITE "${TEST_WORK_DIRECTORY}/undefined.cw"
    "import func Missing() i32; func main() i32 { Missing() }\n")
  expect_preserved_failure("cw:Missing:func()i32" undefined.cw)
  expect_preserved_failure("cannot read link input" entry.cw missing.o)

else()
  message(FATAL_ERROR "unknown native-link scenario: ${DRIVER_SCENARIO}")
endif()

assert_clean_temporary_files()
