# Source-driven stable identity tests, using the existing driver runner helpers.
get_filename_component(linking_cases "${CASE_SOURCE}" DIRECTORY)

if(DRIVER_SCENARIO STREQUAL "stable_link")
  execute_cwc(0 -c "${CASE_SOURCE}" -o provider.o)
  foreach(order IN ITEMS interface_first source_first)
    if(order STREQUAL "interface_first")
      execute_cwc(0 -c provider.cwi "${CASE_SOURCE_2}" -o consumer.o)
    else()
      execute_cwc(0 -c "${CASE_SOURCE_2}" provider.cwi -o consumer.o)
    endif()
    execute_cwc(0 provider.o consumer.o -o linked)
    execute_program(0 "${TEST_WORK_DIRECTORY}/linked")
    if(order STREQUAL "interface_first")
      execute_cwc(0 provider.cwi "${CASE_SOURCE_2}" provider.o -o direct)
    else()
      execute_cwc(0 "${CASE_SOURCE_2}" provider.o provider.cwi -o direct)
    endif()
    execute_program(0 "${TEST_WORK_DIRECTORY}/direct")
  endforeach()
  if(CASE_NAME STREQUAL "stable_link_calls")
    execute_cwc(0 -c "${linking_cases}/calls_subset.cwi" "${CASE_SOURCE_2}" -o subset.o)
    execute_cwc(0 subset.o provider.o -o subset)
    execute_program(0 "${TEST_WORK_DIRECTORY}/subset")
  endif()
  assert_absent("${TEST_WORK_DIRECTORY}/linked.cwi")
  assert_absent("${TEST_WORK_DIRECTORY}/direct.cwi")
  # Wasm objects are checked independently; the existing Wasm driver does not
  # accept external object inputs, so this is not a claim of Wasm linking.
  execute_cwc(0 --target=wasm32-unknown-unknown -c "${CASE_SOURCE}" -o wasm-provider.o)
  execute_cwc(0 --target=wasm32-unknown-unknown -c wasm-provider.cwi "${CASE_SOURCE_2}" -o wasm-consumer.o)

elseif(DRIVER_SCENARIO STREQUAL "stable_symbols")
  if(NOT DEFINED SYMBOL_INSPECTOR OR NOT EXISTS "${SYMBOL_INSPECTOR}")
    message(STATUS "cannot locate llvm-nm; skipping stable object symbol inspection")
    return()
  endif()
  foreach(target IN ITEMS native wasm)
    set(target_args "")
    set(decoration "_")
    if(target STREQUAL "wasm")
      set(target_args --target=wasm32-unknown-unknown)
      set(decoration "")
    endif()
    foreach(case IN ITEMS calls lifetimes virtuals)
      execute_cwc(0 ${target_args} -c "${linking_cases}/${case}_provider.cw" -o "${case}-provider.o")
      execute_cwc(0 ${target_args} -c "${case}-provider.cwi" "${linking_cases}/${case}_consumer.cw" -o "${case}-consumer.o")
      foreach(unit IN ITEMS provider consumer)
        execute_process(COMMAND "${SYMBOL_INSPECTOR}" "${case}-${unit}.o"
          WORKING_DIRECTORY "${TEST_WORK_DIRECTORY}"
          RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
        if(NOT "${result}" STREQUAL "0")
          message(FATAL_ERROR "object inspection failed: ${error}")
        endif()
        if(case STREQUAL "calls")
          foreach(name IN ITEMS "cw:api::Read:func(i64)i32" "cw:api::Read:func(isize)i32"
              "cw:api::Pick:func(&copy i32)i32" "cw:api::Pick:func(&mut i32)i32"
              "cw:api::Pick:func(&move i32)i32" "cw:api::Array:func(&copy [4]i32)i32"
              "cw:api::operator+:func(&copy api::Item,i32)i32" "cw:api::读取:func(i32)i32"
              "cw:api::main:func(i32)i32")
            assert_contains("${symbols}" "${decoration}${name}\n" "${target} ${unit} symbol")
          endforeach()
        elseif(case STREQUAL "lifetimes")
          foreach(name IN ITEMS "cw:lifetime::Base:ctor():complete" "cw:lifetime::Base:ctor():base"
              "cw:lifetime::Base:dtor():complete" "cw:lifetime::Base:dtor():base")
            assert_contains("${symbols}" "${decoration}${name}\n" "${target} ${unit} structor entry")
          endforeach()
          if(unit STREQUAL "provider")
            assert_contains("${symbols}" "${decoration}cw:lifetime::count:var\n" "global symbol")
          endif()
        else()
          assert_contains("${symbols}" "${decoration}cw:SpecialSource:vtable\n" "${target} ${unit} vtable")
          assert_contains("${symbols}" "${decoration}cw:Pointer:func(&copy SpecialSource)*SpecialProduct\n"
                          "shared virtual and ordinary implementation")
        endif()
      endforeach()
    endforeach()
  endforeach()

elseif(DRIVER_SCENARIO STREQUAL "stable_entries")
  file(WRITE "${TEST_WORK_DIRECTORY}/overloaded.cw"
    "func main() i32 { 0 } func main(value i32) i32 { value }")
  file(WRITE "${TEST_WORK_DIRECTORY}/invalid.cw" "export func main() f64 { 1.0 }")
  file(WRITE "${TEST_WORK_DIRECTORY}/variable.cw" "var main i32 := 0;")
  file(WRITE "${TEST_WORK_DIRECTORY}/library.cw"
    "namespace api { func main() i32 { 0 } func main(value i32) i32 { value } }")
  file(WRITE "${TEST_WORK_DIRECTORY}/wasm-entry.cw" "func main(value i32) f64 { 1.0 }")
  file(WRITE "${TEST_WORK_DIRECTORY}/virtual-entry.cw" [=[
import struct Base { virtual { func main(this &copy Base) i32; } }
import ctor Base(); import dtor Base();
struct Derived : Base {}
ctor Derived() { this.Base := Base(); } dtor Derived() {}
]=])
  file(READ "${TEST_WORK_DIRECTORY}/virtual-entry.cw" virtual_entry)
  file(WRITE "${TEST_WORK_DIRECTORY}/virtual-overloaded.cw" "${virtual_entry}\nfunc main() i32 { 0 }")
  foreach(target IN ITEMS native wasm)
    set(target_args "")
    if(target STREQUAL "wasm")
      set(target_args --target=wasm32-unknown-unknown)
    endif()
    foreach(mode IN ITEMS object ir)
      set(mode_args -c)
      if(mode STREQUAL "ir")
        set(mode_args -S -emit-llvm)
      endif()
      execute_cwc(1 ${target_args} ${mode_args} overloaded.cw -o rejected.o)
      assert_contains("${CWC_ERROR}" "must not be overloaded" "root main uniqueness")
      execute_cwc(1 ${target_args} ${mode_args} virtual-overloaded.cw -o rejected.o)
      assert_contains("${CWC_ERROR}" "must not be overloaded" "implicit virtual implementation entry uniqueness")
      execute_cwc(1 ${target_args} ${mode_args} variable.cw -o rejected.o)
      assert_contains("${CWC_ERROR}" "must be a function" "root main kind")
      if(target STREQUAL "native")
        file(WRITE "${TEST_WORK_DIRECTORY}/rejected.cwi" "preserved interface")
        execute_cwc(1 ${mode_args} invalid.cw -o rejected.o)
        assert_contains("${CWC_ERROR}" "program entry must have signature" "native entry signature")
        assert_file_contents("${TEST_WORK_DIRECTORY}/rejected.cwi" "preserved interface")
        execute_cwc(1 ${mode_args} virtual-entry.cw -o rejected.o)
        assert_contains("${CWC_ERROR}" "program entry must have signature" "implicit implementation signature")
      else()
        execute_cwc(0 ${target_args} ${mode_args} wasm-entry.cw -o wasm-entry.o)
      endif()
      assert_absent("${TEST_WORK_DIRECTORY}/rejected.o")
      execute_cwc(0 ${target_args} ${mode_args} library.cw -o library.o)
    endforeach()
  endforeach()

elseif(DRIVER_SCENARIO STREQUAL "stable_duplicates")
  file(WRITE "${TEST_WORK_DIRECTORY}/entry.cw" "func main() i32 { 0 }")
  execute_cwc(0 -c entry.cw -o entry.o)
  foreach(kind IN ITEMS function global)
    if(kind STREQUAL "function")
      set(definition "func Duplicate() i32 { 1 }")
      set(symbol "cw:Duplicate:func()i32")
    else()
      set(definition "var duplicate i32 := 1;")
      set(symbol "cw:duplicate:var")
    endif()
    file(WRITE "${TEST_WORK_DIRECTORY}/one.cw" "${definition}")
    file(WRITE "${TEST_WORK_DIRECTORY}/two.cw" "${definition}")
    execute_cwc(0 -c one.cw -o one.o)
    execute_cwc(0 -c two.cw -o two.o)
    foreach(entry IN ITEMS entry.cw entry.o)
      file(WRITE "${TEST_WORK_DIRECTORY}/protected" "old executable")
      execute_cwc(1 "${entry}" one.o two.o -o protected)
      assert_contains("${CWC_ERROR}" "duplicate symbol" "duplicate ${kind} definition")
      assert_contains("${CWC_ERROR}" "${symbol}" "duplicate identity")
      assert_file_contents("${TEST_WORK_DIRECTORY}/protected" "old executable")
    endforeach()
  endforeach()

elseif(DRIVER_SCENARIO STREQUAL "stable_wasm_export")
  file(WRITE "${TEST_WORK_DIRECTORY}/export.cw"
    "namespace api { func Read(value &copy i32, delta i32) i32 { value + delta } }")
  # A single -Xlinker operand preserves both spaces and commas in the raw symbol.
  execute_cwc(0 --target=wasm32-unknown-unknown export.cw -Xlinker --no-entry
    -Xlinker "--export=cw:api::Read:func(&copy i32,i32)i32" -o export.wasm)
  assert_wasm_module("${TEST_WORK_DIRECTORY}/export.wasm" "raw symbol export"
                     "cw:api::Read:func(&copy i32,i32)i32")
else()
  message(FATAL_ERROR "unknown stable-symbol scenario: ${DRIVER_SCENARIO}")
endif()
