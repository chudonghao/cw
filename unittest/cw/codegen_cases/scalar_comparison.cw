func Equal(left i32, right i32) bool {
  left == right
}

func NotEqual(left i32, right i32) bool {
  left != right
}

func Less(left i32, right i32) bool {
  left < right
}

func LessEqual(left i32, right i32) bool {
  left <= right
}

func Greater(left i32, right i32) bool {
  left > right
}

func GreaterEqual(left i32, right i32) bool {
  left >= right
}

func BooleanEqual(left bool, right bool) bool {
  left == right
}

func BooleanNotEqual(left bool, right bool) bool {
  left != right
}
